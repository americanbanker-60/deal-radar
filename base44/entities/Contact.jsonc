{
  "name": "Contact",
  "type": "object",
  "properties": {
    "target_id": {
      "type": "string",
      "description": "Reference to the BDTarget entity ID"
    },
    "first_name": {
      "type": "string",
      "description": "Contact first name"
    },
    "last_name": {
      "type": "string",
      "description": "Contact last name"
    },
    "email": {
      "type": "string",
      "description": "Contact email address"
    },
    "title": {
      "type": "string",
      "description": "Contact job title"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the primary contact for the target"
    }
  },
  "required": [
    "target_id"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}